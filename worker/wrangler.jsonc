{
  // White Phantom Games launcher backend — Cloudflare Worker.
  // Deploy:  npx wrangler deploy   (from this folder; see README "Going to production")
  "name": "wpg-launcher-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-05-24",
  "observability": { "enabled": true },

  // Custom domain — Cloudflare creates the DNS record for you on first deploy
  // (the zone whitephantomgames.co.uk must be in the same account, which it is).
  "routes": [{ "pattern": "api.whitephantomgames.co.uk", "custom_domain": true }],

  // Game files + catalog.json live here. Create once:  npx wrangler r2 bucket create wpg-cdn
  "r2_buckets": [{ "binding": "CDN", "bucket_name": "wpg-cdn" }],

  // Built-in Workers rate limiting (no dashboard rule needed): per-IP cap on the
  // login routes. namespace_id is any unique integer for this Worker.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 10 } }
  ],

  "vars": {
    "PUBLIC_URL": "https://api.whitephantomgames.co.uk",
    "TOKEN_DAYS": "7"
  }
  // Secrets (never in this file):  npx wrangler secret put <NAME>
  //   PATREON_CLIENT_ID, PATREON_CLIENT_SECRET,
  //   SUBSCRIBESTAR_CLIENT_ID, SUBSCRIBESTAR_CLIENT_SECRET,
  //   SESSION_SECRET  (any long random string; rotating it signs everyone out)
}
