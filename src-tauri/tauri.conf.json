{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "White Phantom Games",
  "version": "0.1.1",
  "identifier": "uk.co.whitephantomgames.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "White Phantom Games",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://127.0.0.1:* https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCRUExNjJFMzYzNTdCOTEKUldTUmV6VTJMaGJxNjd2USt1OFRFRlNsTlljWjUrMkpDcUtpV2NqUC94RmdFZnE0T0g5MkQxQUIK",
      "endpoints": [
        "https://api.whitephantomgames.co.uk/launcher/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}